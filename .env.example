# URL da API (sem /v1) e o mesmo STUDIO_WORKER_TOKEN configurado nela.
# No PC: o domínio público da API (ex.: https://<api>.up.railway.app). O endereço
# *.railway.internal só funciona entre serviços dentro da Railway.
STUDIO_API_URL=https://api.brunofhorn.com.br
STUDIO_WORKER_TOKEN=

# Opcional: narração dos reels (ElevenLabs). Sem a chave, o reel sai sem voz.
ELEVENLABS_API_KEY=
# Voz padrão quando o perfil não define uma (veja `node scripts/narrar.mjs --vozes-pt`).
ELEVENLABS_VOICE_ID=

# Só no modo serve: porta do POST /wake (a Railway define sozinha).
PORT=8080

# Só nos modos start/once: intervalo entre as consultas à fila vazia, em segundos.
POLL_INTERVAL_SECONDS=15
# Threads do Remotion; em máquina fraca, use 2.
REMOTION_CONCURRENCY=

# IA no PC (Configurações › PC): o worker usa o Claude Code logado neste computador.
# Deixe STUDIO_AI vazio; STUDIO_AI=off desliga a IA (só renderiza).
# Modelo e esforço, se quiser trocar os padrões:
STUDIO_AI=
CLAUDE_MODEL=
CLAUDE_EFFORT=medium
